{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "ignoreCommand": "node -e \"process.exit(process.env.VERCEL_GIT_COMMIT_REF === 'main' && (process.env.VERCEL_GIT_COMMIT_AUTHOR_LOGIN || '').toLowerCase() === 'enzoericof' ? 1 : 0)\"",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "campus-backend/",
      "runtime": "container",
      "ignoreCommand": "node -e \"process.exit(process.env.VERCEL_GIT_COMMIT_REF === 'main' && (process.env.VERCEL_GIT_COMMIT_AUTHOR_LOGIN || '').toLowerCase() === 'enzoericof' ? 1 : 0)\"",
      "entrypoint": "Containerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/ws/:path*", "destination": { "service": "backend" } },
    { "source": "/", "destination": { "service": "frontend", "path": "/index.html" } },
    { "source": "/:path*", "destination": { "service": "frontend" } }
  ]
}
