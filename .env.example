# Valores de ejemplo para la ejecución local. No guardar credenciales reales.
# Ver README.md (ejecución con Docker y sin Docker) y campus-backend/setup.md.

# Base de datos del backend cuando se ejecuta sin Docker (campus-backend/.env o variables del entorno).
DB_USER=postgres
DB_PASSWORD=replace-with-a-local-password
CAMPUS_API_URL=http://127.0.0.1:8080

# Credenciales del contenedor de PostgreSQL. Se usan si el archivo se copia como
# .env en la raíz del repositorio, porque docker compose lo lee al levantar los servicios.
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
